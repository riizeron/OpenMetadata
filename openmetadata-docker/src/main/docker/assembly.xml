<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
https://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <id>context</id>
  <formats>
    <format>dir</format>
  </formats>
  <fileSets>
    <fileSet>
      <directory>${maven.multiModuleProjectDirectory}/openmetadata-dist/target</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>openmetadata-*.tar.gz</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/src/main/docker</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>openmetadata-start.sh</include>
        <include>SberCARootExt.crt</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>