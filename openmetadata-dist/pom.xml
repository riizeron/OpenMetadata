<?xml version="1.0" encoding="UTF-8"?>
<!--
  Assembles the OpenMetadata distribution (tar.gz with bin/, conf/, bootstrap/, libs/) from
  published jars and runs the post-build checks that prove the runtime classpath is usable:
    * smoke test: `OpenMetadataApplication check conf/openmetadata.yaml` on target/libs
    * tools/check-dist.sh: jdeps (no missing classes), duplicate-class ratchet, libs.lock diff
  Skip the checks with -Dsmoke.skip=true. Refresh libs.lock / the duplicates baseline after an
  intended dependency change with -Dlock.mode=update.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ru.sber.datalake</groupId>
    <artifactId>omd-platform</artifactId>
    <version>2.0.2-sber.1</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>openmetadata-dist</artifactId>
  <packaging>pom</packaging>
  <name>OpenMetadata Distribution</name>
  <description>OpenMetadata binary distribution</description>

  <properties>
    <final.Name>openmetadata</final.Name>
    <libs.dir>${project.build.directory}/libs</libs.dir>
    <smoke.skip>false</smoke.skip>
    <!-- check | update -->
    <lock.mode>check</lock.mode>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.open-metadata</groupId>
      <artifactId>openmetadata-service</artifactId>
      <version>${openmetadata.version}</version>
    </dependency>
    <dependency>
      <groupId>org.open-metadata</groupId>
      <artifactId>openmetadata-mcp</artifactId>
      <version>${openmetadata.version}</version>
    </dependency>
    <!-- Rebuilt in this reactor (openmetadata-shaded-deps). Declared explicitly so the locally
         built jars replace the ones on Maven Central and `-pl openmetadata-dist -am` works. -->
    <dependency>
      <groupId>org.open-metadata</groupId>
      <artifactId>elasticsearch-deps</artifactId>
      <version>${openmetadata.version}</version>
    </dependency>
    <dependency>
      <groupId>org.open-metadata</groupId>
      <artifactId>opensearch-deps</artifactId>
      <version>${openmetadata.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>${final.Name}-${project.version}</finalName>
    <plugins>
      <plugin>
        <!-- copy-dependencies only adds files, so without this a build after a pin change keeps
             the previous version of the jar next to the new one and every check passes on a
             classpath nobody ships. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-runtime-libs</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${libs.dir}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-libs</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${libs.dir}</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <attach>true</attach>
          <runOnlyAtExecutionRoot>false</runOnlyAtExecutionRoot>
          <tarLongFileMode>posix</tarLongFileMode>
          <descriptors>
            <descriptor>${project.basedir}/src/main/assembly/binary.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-dependency-graph</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <!-- Advisory only: upstream OpenMetadata itself does not satisfy this rule (Jackson is
                   deliberately kept below what Dropwizard 5 declares, Jakarta APIs are mixed, ...).
                   Read the WARNINGs in the build log when adding or bumping a pin. -->
              <fail>false</fail>
              <rules>
                <requireUpperBoundDeps/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- Boots the Dropwizard application far enough to load the main class, logging,
                 Jackson and the configuration. Needs no database or search engine. -->
            <id>smoke-config-check</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${smoke.skip}</skip>
              <executable>java</executable>
              <workingDirectory>${project.basedir}/..</workingDirectory>
              <arguments>
                <argument>-Xmx1G</argument>
                <argument>-cp</argument>
                <argument>${libs.dir}/*</argument>
                <argument>org.openmetadata.service.OpenMetadataApplication</argument>
                <argument>check</argument>
                <argument>conf/openmetadata.yaml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- Attaches every DAO interface of openmetadata-service to a JDBI handle over a stub
                 connection. Catches jdbi3-sqlobject versions the service was not compiled against
                 (ClassCastException on Handler), which `check` cannot reach because it happens
                 only after the DB connection is opened. -->
            <id>smoke-jdbi-attach</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${smoke.skip}</skip>
              <executable>java</executable>
              <workingDirectory>${project.basedir}/..</workingDirectory>
              <arguments>
                <argument>-Xmx1G</argument>
                <argument>-cp</argument>
                <argument>${libs.dir}/*</argument>
                <argument>tools/JdbiAttachSmoke.java</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>check-dist</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${smoke.skip}</skip>
              <executable>bash</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/../tools/check-dist.sh</argument>
                <argument>${libs.dir}</argument>
                <argument>${project.basedir}/libs.lock</argument>
                <argument>${project.basedir}/duplicate-classes.baseline</argument>
                <argument>${lock.mode}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <executions>
          <execution>
            <id>deploy-file</id>
            <phase>deploy</phase>
            <goals>
              <goal>deploy-file</goal>
            </goals>
            <!-- Target repository comes from the plugin's own user properties: -Durl=... -DrepositoryId=... -->
            <configuration>
              <file>${project.build.directory}/${project.build.finalName}.tar.gz</file>
              <groupId>${project.groupId}</groupId>
              <artifactId>${final.Name}</artifactId>
              <version>${project.version}</version>
              <packaging>tar.gz</packaging>
              <classifier>distrib</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Active unless another profile is activated (e.g. -DonlyBackend). -->
      <id>default</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.open-metadata</groupId>
          <artifactId>openmetadata-ui</artifactId>
          <version>${openmetadata.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <!-- Activating this profile deactivates "default", which drops the UI jar from the distribution. -->
      <id>only-backend</id>
      <activation>
        <property>
          <name>onlyBackend</name>
        </property>
      </activation>
    </profile>
  </profiles>
</project>
