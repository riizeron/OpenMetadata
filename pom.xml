<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenMetadata repackaging for the corporate perimeter.

  This reactor does NOT build OpenMetadata sources. It takes the jars published by upstream
  (org.open-metadata:*:${openmetadata.version}) from Maven Central / Nexus, overrides the
  versions of vulnerable transitive libraries via <dependencyManagement>, rebuilds the two
  shaded search-client jars, and assembles the distribution tar.gz and the Docker image.

  Rules for this file:
    * <properties> and <dependencyManagement> are the PATCH LIST. Every entry that differs from
      upstream carries a comment with the upstream value and the reason.
    * Managed versions apply to the whole transitive graph of openmetadata-dist, so a pin here is
      enough to replace a library everywhere. No need to touch upstream poms.
    * When bumping ${openmetadata.version}: re-read upstream platform-<ver>.pom, drop pins that
      upstream has caught up with, and re-run the checks (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ru.sber.datalake</groupId>
  <artifactId>omd-platform</artifactId>
  <version>2.0.2-sber.1</version>
  <packaging>pom</packaging>

  <name>OpenMetadata (Sber repackaging)</name>
  <description>
    OpenMetadata ${openmetadata.version} distribution assembled from published jars with
    patched transitive dependencies. Upstream: https://github.com/open-metadata/OpenMetadata
  </description>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>openmetadata-shaded-deps</module>
    <module>openmetadata-dist</module>
    <module>openmetadata-docker</module>
  </modules>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Upstream OpenMetadata release that is being repackaged. Used for every org.open-metadata:* artifact. -->
    <openmetadata.version>2.0.2</openmetadata.version>

    <!-- ===== Patched library versions (upstream 2.0.2 value in the comment) ===== -->
    <jackson.version>2.18.10</jackson.version>               <!-- upstream 2.18.10 -->
    <!-- Do NOT bump above 3.37.x: since JDBI 3.38.0 the SqlObject handlers no longer implement
         org.jdbi.v3.sqlobject.Handler, and openmetadata-service 2.0.2 (compiled against 3.37.1)
         fails with a ClassCastException when attaching MigrationDAO. Verified by tools/JdbiAttachSmoke.java. -->
    <jdbi3.version>3.37.1</jdbi3.version>                    <!-- upstream 3.37.1 -->
    <jetty.version>12.1.12</jetty.version>                   <!-- upstream 12.1.12 (service pom still says 12.1.10) -->
    <slf4j.version>2.0.17</slf4j.version>                    <!-- upstream 2.0.4 -->
    <logback.version>1.5.36</logback.version>                <!-- upstream 1.5.36 -->
    <netty.version>4.2.18.Final</netty.version>              <!-- upstream 4.2.18.Final (netty-bom in platform pom) -->
    <spring.version>7.0.9</spring.version>                   <!-- upstream 7.0.9 -->
    <httpcore5.version>5.4.3</httpcore5.version>             <!-- upstream 5.4.3 (bundled in shaded jars) -->
    <httpclient5.version>5.6.4</httpclient5.version>         <!-- upstream 5.6.4 (bundled in shaded jars) -->
    <jsonschema2pojo.version>1.3.3</jsonschema2pojo.version> <!-- upstream 1.3.1 · SCA -->
    <protobuf-java.version>4.33.2</protobuf-java.version>    <!-- upstream via google libs · SCA -->

    <!-- Family BOMs whose whole version set has to be consistent. dropwizard is upstream's
         value; the rest are raised above what upstream ships (requireUpperBoundDeps). -->
    <dropwizard.version>5.0.0</dropwizard.version>
    <metrics.version>4.2.37</metrics.version>                 <!-- required by dropwizard 5.0.0; service declares 4.2.19 -->
    <micrometer.version>1.16.7</micrometer.version>           <!-- upstream 1.16.7; whole family via BOM -->
    <prometheus-metrics.version>1.4.3</prometheus-metrics.version> <!-- required by micrometer-registry-prometheus 1.16.7; service declares 1.3.6 -->
    <asm.version>9.10.1</asm.version>                         <!-- required by jetty-ee10-annotations 12.1.12; json-smart brings 9.7.1 -->

    <!-- Plugin versions -->
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
    <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    <maven-assembly-plugin.version>3.4.2</maven-assembly-plugin.version>
    <maven-dependency-plugin.version>3.6.0</maven-dependency-plugin.version>
    <maven-deploy-plugin.version>3.0.0</maven-deploy-plugin.version>
    <exec-maven-plugin.version>3.1.0</exec-maven-plugin.version>
    <docker-maven-plugin.version>0.48.1</docker-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- ===== BOM imports: one version for every artifact of the family ===== -->
      <dependency>
        <groupId>org.jdbi</groupId>
        <artifactId>jdbi3-bom</artifactId>
        <version>${jdbi3.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${slf4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-bom</artifactId>
        <version>${jetty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty.ee10</groupId>
        <artifactId>jetty-ee10-bom</artifactId>
        <version>${jetty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.dropwizard</groupId>
        <artifactId>dropwizard-bom</artifactId>
        <version>${dropwizard.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.dropwizard.metrics</groupId>
        <artifactId>metrics-bom</artifactId>
        <version>${metrics.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.prometheus</groupId>
        <artifactId>prometheus-metrics-bom</artifactId>
        <version>${prometheus-metrics.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- ===== Security pins (SCA) ===== -->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-core</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-beans</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-expression</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5-h2</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.client5</groupId>
        <artifactId>httpclient5</artifactId>
        <version>${httpclient5.version}</version>
      </dependency>
      <dependency>
        <!-- 1.3.x pulls Jackson 3 (tools.jackson); OpenMetadata is on Jackson 2, so it is excluded. -->
        <groupId>org.jsonschema2pojo</groupId>
        <artifactId>jsonschema2pojo-core</artifactId>
        <version>${jsonschema2pojo.version}</version>
        <exclusions>
          <exclusion>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
          </exclusion>
          <exclusion>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.jsoup</groupId>
        <artifactId>jsoup</artifactId>
        <version>1.23.2</version>                          <!-- upstream 1.23.2 -->
      </dependency>
      <dependency>
        <groupId>org.apache.calcite</groupId>
        <artifactId>calcite-core</artifactId>
        <version>1.42.0</version>                          <!-- upstream 1.42.0 -->
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-commons</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-tree</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-util</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-analysis</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.thrift</groupId>
        <artifactId>libthrift</artifactId>
        <version>0.24.0</version>                          <!-- upstream 0.24.0 -->
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>1.85</version>                            <!-- upstream 1.85 -->
      </dependency>
      <dependency>
        <groupId>org.openjdk.nashorn</groupId>
        <artifactId>nashorn-core</artifactId>
        <version>15.7</version>                            <!-- upstream 15.4 via json-logic · SCA -->
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf-java.version}</version>
      </dependency>
      <dependency>
        <!-- google-cloud-secretmanager 2.81.0 brings protobuf-java-util 3.25.8; keep it in step with protobuf-java -->
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf-java.version}</version>
      </dependency>

      <dependency>
        <!-- upstream manages 1.26.0; without the pin the platform import below would pull it down -->
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.27.1</version>                          <!-- upstream 1.26.0 · SCA -->
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.20.0</version>                          <!-- upstream 3.18.0 · SCA -->
      </dependency>

      <!-- ===== Consistency with dropwizard 5.0.0 (reported by requireUpperBoundDeps) ===== -->
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>8.0.3.Final</version>                     <!-- service declares 8.0.1.Final, dropwizard-jersey needs 8.0.3 -->
      </dependency>
      <dependency>
        <groupId>com.fasterxml</groupId>
        <artifactId>classmate</artifactId>
        <version>1.7.0</version>                           <!-- 1.5.1 via hibernate-validator 8.0.1 -->
      </dependency>
      <dependency>
        <groupId>org.jboss.logging</groupId>
        <artifactId>jboss-logging</artifactId>
        <version>3.6.1.Final</version>                     <!-- 3.4.3.Final via hibernate-validator 8.0.1 -->
      </dependency>
      <dependency>
        <groupId>commons-logging</groupId>
        <artifactId>commons-logging</artifactId>
        <version>1.3.5</version>                           <!-- 1.2 via httpclient 4; search clients need 1.3.5 -->
      </dependency>

      <!-- ===== Upstream's own dependencyManagement, applied to our graph =====
           Maven applies dependencyManagement only from the project being built, never from the
           poms of its dependencies. Importing the upstream root pom (org.open-metadata:platform)
           replays upstream's managed versions over the whole transitive graph, so libraries that
           upstream pins for its reactor (reactor-core, okhttp, gson, angus-mail, ...) resolve here
           exactly as in the upstream distribution. Precedence: the explicit entries above win over
           this import; among imports the first declared wins, so the family BOMs above also win. -->
      <dependency>
        <!-- explicit copy of upstream's entry: it carries an exclusion, and our dropwizard-bom import
             above would otherwise win over the imported entry and lose it -->
        <groupId>io.dropwizard</groupId>
        <artifactId>dropwizard-core</artifactId>
        <version>${dropwizard.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.slf4j</groupId>
            <artifactId>log4j-over-slf4j</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.open-metadata</groupId>
        <artifactId>platform</artifactId>
        <version>${openmetadata.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${maven-assembly-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>io.fabric8</groupId>
          <artifactId>docker-maven-plugin</artifactId>
          <version>${docker-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
